# QQ Open Platform (https://q.qq.com) — fill locally, never commit real values.
QQ_APP_ID=YOUR_QQ_APP_ID
QQ_APP_SECRET=YOUR_QQ_APP_SECRET
# 主人 QQ 号。群事件里没有 QQ 号，须先私聊 /bind 该号码，斜杠指令才可用。
QQ_ID=

# OpenAI-compatible API. Chat + images use LLM_MODEL in one multimodal call.
# DeepSeek official IDs: deepseek-flash (vision) / deepseek-v4-pro — NOT display names like DeepSeek-V4.1-Flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=YOUR_API_KEY
LLM_MODEL=deepseek-flash
# Optional; blank follows LLM_MODEL. Kept for admin UI compatibility only.
VISION_MODEL=deepseek-flash

# Optional overrides
# QQ_API_BASE=https://api.sgroup.qq.com
# HOST=0.0.0.0
# PORT=8080
# LLM_TIMEOUT_SECONDS=25
# VISION_TIMEOUT_SECONDS=20
# MEMORY_MAX_TURNS=12
# 收到消息后等待多久再回复；此窗口内同一用户连发会合并成一条
# COALESCE_SINGLE_DEBOUNCE_SECONDS=3.0
# COALESCE_DEBOUNCE_SECONDS=3.0
# COALESCE_BURST_SECONDS=30
# 回复开关与频率见项目根目录 reply_policy.toml（改完下次消息即生效）
# REPLY_POLICY_PATH=./reply_policy.toml
# STICKERS_DIR=./data/stickers
# STICKERS_INDEX_PATH=./stickers.toml
# PERSONAS_DIR=./data/personas
# PERSONAS_INDEX_PATH=./personas.toml
# 入站表情评估后自动收藏（落盘 + stickers.toml description）；同 MD5 不再识图
# STICKER_AUTO_LEARN=true
# STICKER_LEARN_MAX=200
